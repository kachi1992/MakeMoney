{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MakeMoney frozen recommendation snapshot v1.1",
  "description": "Design contract; append lifecycle events separately. Cross-field, permission and time checks are mandatory beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendation_id", "signal_id", "security_id", "issuer_id", "portfolio_run_id", "universe_snapshot_id", "strategy_version", "execution_model_version", "label_version", "feature_version", "model_version", "prompt_version", "decision_session", "ticker", "disclosure", "data_cutoff_at", "computed_at", "frozen_at", "published_at", "eligible_execution_at", "expires_at", "schema_version", "synthetic", "status", "data_snapshot_sha256", "action", "previous_weight", "target_weight", "score", "coverage", "calibrated_probability", "primary_horizon_sessions", "components", "penalty", "evidence_refs", "reason_claims", "risk_flags", "invalidation_conditions"],
  "properties": {
    "recommendation_id": {"type": "string", "format": "uuid"},
    "signal_id": {"type": "string", "format": "uuid"},
    "security_id": {"type": "string", "format": "uuid"},
    "issuer_id": {"type": "string", "format": "uuid"},
    "portfolio_run_id": {"type": "string", "format": "uuid"},
    "universe_snapshot_id": {"type": "string", "format": "uuid"},
    "strategy_version": {"type": "string", "minLength": 1},
    "execution_model_version": {"type": "string", "minLength": 1},
    "label_version": {"type": "string", "minLength": 1},
    "feature_version": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "decision_session": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "minLength": 1},
    "disclosure": {"type": "string", "minLength": 1},
    "data_cutoff_at": {"type": "string", "format": "date-time"},
    "computed_at": {"type": "string", "format": "date-time"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": "string", "format": "date-time"},
    "eligible_execution_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": "1.1"},
    "synthetic": {"type": "boolean"},
    "status": {"const": "published_frozen"},
    "data_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {"enum": ["BUY", "ADD", "HOLD", "REDUCE", "SELL", "WATCH", "ABSTAIN"]},
    "previous_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "target_weight": {"type": "number", "minimum": 0, "maximum": 1},
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "calibrated_probability": {"type": "null", "description": "Rules-v1 is not calibrated; never map score/100 to probability."},
    "primary_horizon_sessions": {"const": 20},
    "components": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "weight", "score", "missing_reason"],
        "properties": {
          "name": {"enum": ["F", "Q", "V", "C", "M", "E"]},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "missing_reason": {"type": ["string", "null"]}
        }
      }
    },
    "penalty": {"type": "number", "minimum": 0, "maximum": 25},
    "evidence_refs": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "reason_claims": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "text", "evidence_refs"],
        "properties": {
          "type": {"enum": ["fact", "management_claim", "inference", "rule_explanation"]},
          "text": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "format": "uuid"}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "risk_flags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "invalidation_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
